# ============================================
# 华为网络设备自动化运维系统 - 环境变量配置
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改下面的配置值
# 3. 系统启动时会自动读取 .env 文件中的配置

# ============================================
# 服务器配置
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# ============================================
# 数据库配置
# ============================================
# SQLite: sqlite:///data/network.db
# MySQL: mysql+pymysql://user:password@host:port/dbname
# PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///data/network.db
DATABASE_ECHO=false

# ============================================
# 安全配置
# ============================================
# JWT密钥（生产环境请务必修改为随机字符串）
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRE_HOURS=24
API_RATE_LIMIT=100

# ============================================
# 华为设备默认配置
# ============================================
HUAWEI_DEFAULT_USERNAME=admin
HUAWEI_DEFAULT_PASSWORD=Admin@123
HUAWEI_SSH_PORT=22
HUAWEI_CONNECTION_TIMEOUT=30
HUAWEI_COMMAND_TIMEOUT=60

# ============================================
# 监控配置
# ============================================
MONITORING_CHECK_INTERVAL=60
MONITORING_CPU_THRESHOLD=80
MONITORING_MEMORY_THRESHOLD=85
MONITORING_BANDWIDTH_THRESHOLD=90
MONITORING_LATENCY_THRESHOLD=100
MONITORING_PACKET_LOSS_THRESHOLD=1

# ============================================
# 自动优化配置
# ============================================
AUTO_OPTIMIZATION_ENABLED=true
AUTO_OPTIMIZATION_CHECK_INTERVAL=300
AUTO_OPTIMIZATION_ENABLE_ROUTE=true
AUTO_OPTIMIZATION_ENABLE_BANDWIDTH=true
AUTO_OPTIMIZATION_ENABLE_LOAD_BALANCE=true

# ============================================
# 企业微信通知配置
# ============================================
WECHAT_ENABLED=true
WECHAT_CORP_ID=your-corp-id
WECHAT_AGENT_ID=your-agent-id
WECHAT_SECRET=your-secret

# ============================================
# 阿里云短信配置
# ============================================
SMS_ENABLED=true
SMS_ACCESS_KEY_ID=your-access-key-id
SMS_ACCESS_KEY_SECRET=your-access-key-secret
SMS_SIGN_NAME=网络运维
SMS_TEMPLATE_CODE=SMS_123456789

# ============================================
# 邮件通知配置
# ============================================
EMAIL_ENABLED=true
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your-password
FROM_ADDRESS=noreply@example.com
TO_ADDRESSES=admin@example.com,ops@example.com

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/network-auto.log
LOG_MAX_SIZE=100
LOG_BACKUP_COUNT=10

# ============================================
# ZTP零接触部署配置
# ============================================
ZTP_ENABLED=true

# DHCP配置
ZTP_DHCP_ENABLED=true
ZTP_DHCP_SERVER_IP=192.168.1.10
ZTP_DHCP_LEASE_START=192.168.1.100
ZTP_DHCP_LEASE_END=192.168.1.200
ZTP_DHCP_SUBNET_MASK=255.255.255.0
ZTP_DHCP_GATEWAY=192.168.1.1
ZTP_DHCP_DNS_SERVER=8.8.8.8
ZTP_DHCP_LEASE_TIME=86400

# TFTP配置
ZTP_TFTP_ENABLED=true
ZTP_TFTP_PORT=69
ZTP_TFTP_ROOT_DIR=/tftpboot
ZTP_TFTP_SERVER_IP=192.168.1.10

# HTTP配置
ZTP_HTTP_ENABLED=true
ZTP_HTTP_PORT=8080
ZTP_HTTP_SERVER_URL=http://192.168.1.10:8080

# 设备发现配置
ZTP_DISCOVERY_ENABLED=true
ZTP_DISCOVERY_INTERFACE=
ZTP_DISCOVERY_SCAN_INTERVAL=60
ZTP_DISCOVERY_MAX_AGE_HOURS=24

# 配置模板配置
ZTP_TEMPLATES_DIR=/ztp/templates
ZTP_DEFAULT_SWITCH_TEMPLATE=default_switch
ZTP_DEFAULT_ROUTER_TEMPLATE=default_router
